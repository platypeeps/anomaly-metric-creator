{
  "enabledPlugins": {
    "sd@sd-ai-command-pack": true
  },
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "extraKnownMarketplaces": {
    "sd-ai-command-pack": {
      "source": {
        "repo": "platypeeps/sd-ai-command-pack",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/inject-subagent-context.py",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Task"
      },
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/inject-subagent-context.py",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Agent"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/session-start.py",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup"
      },
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/session-start.py",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "clear"
      },
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/session-start.py",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/inject-workflow-state.py",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "command": "python3 .claude/hooks/statusline.py",
    "type": "command"
  }
}
