.DS_Store
.env
.env.*
.env-*
.vscode
.idea
__pycache__
iot_logs
otel-activity.log
.venv
.pytest_cache
*.egg-info

.worktrees

# Generated Obsidian KB copy folder; source docs remain in normal repo paths.
# It is a symlink, so the rule must be `/.obsidian-kb` and not `.obsidian-kb/`.
/.obsidian-kb

# Trellis runtime state. Nothing under `.trellis/` is tracked any more -- the
# directory only survives as local residue on machines that once ran it -- so
# the whole tree is ignored rather than the handful of runtime subpaths that
# used to be carved out of a tracked adapter tree.
.trellis/

# Review/build artifacts.
.build/
code-review-report.json
code-review-report.md

# AI-tool local state. Only the roots this repository actually tracks are
# listed: `.agents/`, `.claude/`, `.codex/`, `.gemini/`, `.opencode/`. The
# previous block enumerated eighteen vendor directories, seventeen of which
# have never held a tracked file here. The rendered skill payloads under these
# roots are tracked and must stay tracked, so only local state is ignored.
.agents/**/*.local.*
.agents/**/.cache/
.agents/**/cache/
.agents/**/logs/
.agents/**/tmp/
.agents/**/*.log
.claude/settings.local.json
.claude/**/*.local.*
.claude/**/.cache/
.claude/**/cache/
.claude/**/logs/
.claude/**/tmp/
.claude/**/*.log
.codex/**/*.local.*
.codex/**/.cache/
.codex/**/cache/
.codex/**/logs/
.codex/**/sessions/
.codex/**/tmp/
.codex/**/*.log
.gemini/settings.local.json
.gemini/**/*.local.*
.gemini/**/.cache/
.gemini/**/cache/
.gemini/**/logs/
.gemini/**/tmp/
.gemini/**/*.log
.opencode/**/*.local.*
.opencode/**/.cache/
.opencode/**/cache/
.opencode/**/logs/
.opencode/**/tmp/
.opencode/**/state/
.opencode/**/sessions/
.opencode/node_modules/
.opencode/**/*.log
node_modules/

# Coverage artifacts from the CI-style pytest --cov invocation.
.coverage
.coverage.*
coverage.xml

# mypy incremental cache.
.mypy_cache/

# ruff cache (protected only by ruff's own nested .gitignore otherwise).
.ruff_cache/

# understand-anything generated analysis cache (knowledge graph / fingerprints).
.understand-anything/
