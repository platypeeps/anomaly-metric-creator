#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
ARTIFACT="docs/repomix-map.md"

if ! command -v repomix >/dev/null 2>&1; then
  printf 'error: repomix is required to refresh %s\n' "$ARTIFACT" >&2
  printf 'install it from https://repomix.com/ or with your preferred package manager\n' >&2
  exit 127
fi

cd "$REPO_ROOT"
mkdir -p "$(dirname "$ARTIFACT")"

# The only path this script excludes is the artifact itself. Repomix also drops
# `uv.lock` through its own built-in default patterns, which are named in no
# file here -- see the docstring of tools/check_repomix_map_freshness.py, which
# is why that guard checks map-to-tree and not the reverse.
#
# It used to exclude the framework's task directories as well, for a reason that
# no longer holds and is worth recording rather than deleting. Archiving a task
# moved a whole directory, which stranded map lines and failed the map's own
# freshness guard (tools/check_repomix_map_freshness.py) on the archive commit
# -- and the fix, regenerating the map into that commit, was rejected by the
# framework's completion finalization, which required the post-work delta to
# carry only bookkeeping paths. The commit could satisfy one gate or the other,
# never both, so the paths were excluded to dissolve the conflict.
#
# The finalization gate went with the framework on 2026-08-30. Work items under
# `docs/work/` archive the same way, but the archive commit may now simply carry
# the regenerated map, so there is nothing left to exclude and the map describes
# the whole tracked tree again.

repomix . \
  --quiet \
  --style markdown \
  --no-files \
  --no-git-sort-by-changes \
  --include-full-directory-structure \
  --output "$ARTIFACT" \
  --ignore "$ARTIFACT" \
  --header-text "Generated metadata-only repository map for anomaly-metric-creator. This artifact is generated with --no-files: it contains repository metadata and directory structure only, with no source file bodies. Refresh with scripts/update_repomix after code, docs, tests, scripts, or platform skill tree changes."

printf 'Updated %s\n' "$ARTIFACT"
