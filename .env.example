# Template for the MEZMO_OTEL_* variables documented in README.md
# ("OTEL streaming"). Copy it to an ignored file, for example `.env` or
# `.env.<target>`, replace every change-me value, then export it:
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#   amc --otel-send logs,metrics,traces
#
# amc does not read this file itself; it reads the exported environment.
# Streaming stays off unless --otel-send selects a signal.
# --otel-endpoint and --otel-auth-token override the per-signal values below.

# Per-signal OTLP/HTTP endpoints.
MEZMO_OTEL_LOGS_ENDPOINT=https://change-me.example/v1/logs
MEZMO_OTEL_METRICS_ENDPOINT=https://change-me.example/v1/metrics
MEZMO_OTEL_TRACES_ENDPOINT=https://change-me.example/v1/traces

# Per-signal auth tokens. Never commit real values.
MEZMO_OTEL_LOGS_AUTH_TOKEN=change-me
MEZMO_OTEL_METRICS_AUTH_TOKEN=change-me
MEZMO_OTEL_TRACES_AUTH_TOKEN=change-me

# Payload mode: protobuf (default) or json.
MEZMO_OTEL_STREAM_PROTOCOL=protobuf
# Authorization header prefix (default Bearer).
MEZMO_OTEL_STREAM_AUTH_SCHEME=Bearer
